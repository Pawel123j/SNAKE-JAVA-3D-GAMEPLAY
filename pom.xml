<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pawel</groupId>
    <artifactId>snake-3d-deluxe</artifactId>
    <version>1.0.0</version>
    <name>Snake 3D Deluxe</name>
    <description>Premium 3D Snake game built with JavaFX 3D</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.2</javafx.version>
        <junit.version>5.10.2</junit.version>
        <!-- The headless smoke test is opt-in; the CI "smoke" job sets this true under xvfb. -->
        <snake.smoke.headless>false</snake.smoke.headless>
        <prism.order>sw</prism.order>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Natywne biblioteki JavaFX (prism, glass, font) dla głównych
             platform desktopowych, żeby JAR z zależnościami uruchamiał się
             niezależnie od tego, na czym został zbudowany.
             Uwaga: natywne pliki dla macOS na Intelu i na Apple Silicon mają
             identyczne nazwy, więc jeden JAR może nieść tylko jeden z tych
             zestawów — wybrany jest aarch64, czyli dzisiejszy domyślny.
             Na Intel macOS, ARM Linux i systemach 32-bitowych trzeba
             uruchamiać przez `mvn javafx:run`, które pobiera pasujące
             biblioteki samo. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>win</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>mac-aarch64</classifier>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <snake.smoke.headless>${snake.smoke.headless}</snake.smoke.headless>
                        <prism.order>${prism.order}</prism.order>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.pawel.snake3d.Snake3DApp</mainClass>
                </configuration>
            </plugin>

            <!-- Buduje samodzielny, klikalny JAR dla głównych platform
                 (Windows x86-64, Linux x86-64, macOS Apple Silicon):
                 target/snake-3d-deluxe-1.0.0-shaded.jar

                 Main-Class to Launcher, a nie Snake3DApp: środowisko
                 uruchomieniowe odmawia startu klasy dziedziczącej po
                 javafx.application.Application jako Main-Class grubego JAR-a
                 ("JavaFX runtime components are missing"). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>shaded</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.pawel.snake3d.Launcher</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
